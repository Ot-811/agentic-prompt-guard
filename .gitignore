# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ── Distribution / packaging ───────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── Testing & coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── Type checkers ─────────────────────────────────────────────────────────────
.mypy_cache/
.pytype/
.pyre/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── HuggingFace / sentence-transformers model cache ───────────────────────────
# (models are downloaded at runtime to ~/.cache/huggingface; nothing to commit)
*.bin
*.safetensors
*.onnx

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
Thumbs.db

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── Logs & temp files ─────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.swp
*.swo

# ── Large generated datasets (tracked via Git LFS or excluded entirely) ────────
# The 100k-row CSV is 23 MB; exclude from normal commits — regenerate with:
#   python generate_dataset.py
generated_pharma_dataset_*.csv
